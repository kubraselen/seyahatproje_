@using seyahatproje.Models.siniflar 
@model List<Hakkimizda>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_TestLayout.cshtml";
}

<div class="content">
    <div class="wrap">
        <div class="about">
            <h3>Hakkımızda</h3>
            @foreach (var x in Model)
            {
                <p>@x.Aciklama </p>
                <img src=@x.FotoUrl alt="" style="height:500px; width:850px;" />
            }


        </div>
    </div>
    </div>
