@model seyahatproje.Models.siniflar.rezervasyonum
@{
    ViewBag.Title = "yenirezervasyonum";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Yeni Rezervasyon Ekle</h2>
<br/>
<form class="form-group" method="post">
    @Html.LabelFor(x => x.Ad)
    @Html.TextBoxFor(x => x.Ad, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.Soyad)
    @Html.TextBoxFor(x => x.Soyad, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.mail)
    @Html.TextBoxFor(x => x.mail, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.odaturu)
    @Html.TextBoxFor(x => x.odaturu, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.odasayisi)
    @Html.TextBoxFor(x => x.odasayisi, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.Telefon)
    @Html.TextBoxFor(x => x.Telefon, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.giristarihi)
    @Html.TextBoxFor(x => x.giristarihi, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.cikistarihi)
    @Html.TextBoxFor(x => x.cikistarihi, new { @class = "form-control" })
    <br />
    <button class="btn btn-primary">Rezervasyon Ekle</button>
    
</form>
